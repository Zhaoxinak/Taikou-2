	[34.28, 134.85],
]

const _SADO := [
	[38.32, 138.42], [38.10, 138.20], [37.82, 138.28], [37.92, 138.48], [38.20, 138.52],
]


## 返回 [{points: PackedVector2Array, color: Color}]（逻辑坐标，0..48×0..36）
static func polygons() -> Array:
	var out := []
	for ring in [_HONSHU, _KYUSHU, _SHIKOKU, _SADO]:
		var pts := PackedVector2Array()
		for pt in ring:
			pts.append(_proj(float(pt[0]), float(pt[1])))
		out.append(pts)
	return out


## 知名山系（lat, lon, 名称）—— 大地图山形符号
