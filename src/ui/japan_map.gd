		[35.36, 138.73, "富士"],
		[33.28, 133.11, "石鎚"],
		[32.88, 131.08, "阿蘇"],
	]


## 山 → 逻辑坐标
static func mountain_pos(m: Array) -> Vector2:
	return _proj(float(m[0]), float(m[1]))
