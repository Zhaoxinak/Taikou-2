extends RefCounted
## japan_map.gd — 日本列岛简化轮廓（史实海岸线多边形，供大地图背景绘制）
##
## 多边形为简化海岸线折线（经纬度 → 与 gen_castle_map.py 相同的等距投影），
## 覆盖本州 / 九州 / 四国 / 佐渡（不含北海道，原版地图范围）。
## 用法：japan_map.polygons() 返回 [{points: PackedVector2Array(逻辑坐标), color: Color}, ...]
##
## ⚠️ 不用 class_name（--script 无头模式不建全局类缓存），跨文件 preload。

const WorldMapRef = preload("res://src/core/world_map.gd")

# 与 scripts/gen_castle_map.py 投影参数一致
const LON0 := 128.6
const LON1 := 142.2
const LAT0 := 30.8
const LAT1 := 41.7
const MAP_W := 48.0
const MAP_H := 36.0


static func _proj(lat: float, lon: float) -> Vector2:
	var x := (lon - LON0) / (LON1 - LON0) * (MAP_W - 1)
	var y := (LAT1 - lat) / (LAT1 - LAT0) * (MAP_H - 1)
	return Vector2(x, y)


