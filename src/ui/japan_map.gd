	[34.00, 136.30], [34.45, 136.75], [34.72, 136.95], [34.70, 137.80], [34.80, 138.50],
	[34.70, 138.95], [35.12, 139.72], [35.30, 139.80], [35.60, 140.05], [35.75, 140.85],
	[36.30, 140.75], [36.80, 140.85], [37.20, 141.05], [38.30, 141.20], [38.60, 141.55],
