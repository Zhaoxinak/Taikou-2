theme_override_constants/separation = 6

[node name="Swatch" type="ColorRect" parent="Panel/Margin/Body/Legend/LegendRowM/Chip"]
custom_minimum_size = Vector2(22, 22)
layout_mode = 2
color = Color(0.90, 0.38, 0.34, 1)

[node name="Text" type="Control" parent="Panel/Margin/Body/Legend/LegendRowM/Chip"]
layout_mode = 2
script = ExtResource("3_label")
text = "从属"
color = Color(0.90, 0.38, 0.34, 1)
font_size = 24

[node name="Chip" type="HBoxContainer" parent="Panel/Margin/Body/Legend/LegendRowM"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Swatch" type="ColorRect" parent="Panel/Margin/Body/Legend/LegendRowM/Chip"]
custom_minimum_size = Vector2(22, 22)
layout_mode = 2
color = Color(0.36, 0.80, 0.45, 1)

[node name="Text" type="Control" parent="Panel/Margin/Body/Legend/LegendRowM/Chip"]
