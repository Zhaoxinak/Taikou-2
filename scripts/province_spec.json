  "fields": {
    "+0": {
      "type": "u8",
      "name": "size_tier_packed",
      "desc": "低4位=规模档(0..15)，供 UI/MSGX 分支；高2位(bit4-5)运行时可写，作产量系数 (2*hi+5)。初始化时高2位多为0。",
      "readers": [
        "0x464553 (low4→MSGX 0x1a8/0x1a9)",
        "0x4a5bca (hi2→生产率系数)"
      ]
    },
    "+1": {
      "type": "u8",
      "name": "climate_group",
      "desc": "地域/气候组。天气完整版 0x43d0e0：∈{0,2,4} 走雪国冬季表。事件 opcode14 比较此字节。",
      "snow_groups": [
        0,
        2,
        4
      ],
      "observed_init": [
        0,
        1,
        2,
        3,
        100,
        255
      ]
    },
    "+2": {
      "type": "u8",
      "name": "flags",
      "desc": "位标志。已见 bit6(0x40) 参与城内政/生产率修正 (0x4aa160: movzx +2; add eax,5 作乘数基)。",
      "known_bits": {
        "0x40": "生产率/内政修正开关（13国初始置位）"
      }
    },
    "+3..+4": {
      "type": "u16 LE",
      "name": "yield_and_band",
      "desc": "一词两用：低字节位域 + 高字节地图带",
      "bit_layout": {
        "bits0_1": "保留标志 yield_lo2（49b280 写入时用 mask 0xFF83 保留）",
        "bits2_6": "yield_hi5 (0..31)，月度米价/收成基值；0x4a59d0 每月读出+随机后经 0x49b280 写回（钳制写入≤29，读侧常用[6,22]）",
        "bits8_15": "map_band 地理带 0=最北 .. 8=九州四国（肥后初始异常19，跨剧本+1）"
      },
      "accessor_hi5": "0x4cfd50 / 0x4cfef0 / 0x4d0070: (byte[+3]>>2)&0x1f",
      "setter_hi5": "0x49b280(prov*, val): and word[+3],0xFF83; or (min(val,0x1d)<<2)"
    }
  },
